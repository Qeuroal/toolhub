# font
font-family = "JetBrainsMonoNL Nerd Font"
font-family = "LXGW WenKai Mono"
font-family = "Noto Sans Mono CJK SC"
# 解决 Dingbats 过小的问题
font-codepoint-map = U+2700-U+27BF=Noto Sans Symbols 2
font-size = 20
font-thicken = true
font-thicken-strength = 255
window-inherit-font-size = true
window-title-font-family = "JetBrainsMonoNL Nerd Font"
adjust-underline-position = 4

# cell
adjust-cell-width = 0
adjust-cell-height = 0

# cursor
cursor-style = block
shell-integration-features = no-cursor
cursor-style-blink = false
cursor-color = #ff6347
cursor-text = #ffffff
macos-option-as-alt = true
adjust-underline-thickness = 1
adjust-cursor-thickness = 4
adjust-overline-thickness = 2
cursor-opacity = 1

# mouse
mouse-hide-while-typing = true

# clip
clipboard-read = "allow"
clipboard-write = "allow"

# 复制和配置重载时显示应用内通知 (仅 Linux GTK 生效)
app-notifications = clipboard-copy,config-reload

# theme
# onedarkpro, details: ghostty +list-themes
theme = catppuccin-macchiato.conf
# cursor-invert-fg-bg = true
# window-theme = ghostty

# background
background-opacity = 1
background-blur = false

# window
maximize = true
# fullscreen = true
window-decoration = auto
# macOS 显示标签页; Linux GTK 隐藏标题栏和标签栏
macos-titlebar-style = tabs
# macos-titlebar-proxy-icon = hidden
gtk-titlebar-style = native
gtk-titlebar = false

# tab
gtk-tabs-location = hidden

# split
unfocused-split-opacity = 0.7
split-divider-color = #3366ff

# update
auto-update = check
auto-update-channel = tip

# other
# copy-on-select = clipboard

# confirm
confirm-close-surface = true

# keymapping
keybind = clear
keybind = ctrl+shift+u=scroll_page_up
keybind = ctrl+shift+d=scroll_page_down
keybind = ctrl+shift+y=scroll_page_lines:-1
keybind = ctrl+shift+e=scroll_page_lines:1
# keybind = super+comma=unbind
keybind = super+f=start_search
keybind = ctrl+shift+f=start_search
keybind = performable:escape=end_search

#{{{> default
keybind = all:super+alt+shift+w=close_window
keybind = super+alt+w=close_tab:this
keybind = super+shift+bracket_left=previous_tab
keybind = super+shift+bracket_right=next_tab
keybind = super+shift+comma=reload_config
keybind = super+shift+w=close_window
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+tab=next_tab
keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5
keybind = super+6=goto_tab:6
keybind = super+7=goto_tab:7
keybind = super+8=goto_tab:8
keybind = super+9=last_tab
keybind = ctrl+enter=text:\r
keybind = super+enter=toggle_fullscreen
keybind = super+c=copy_to_clipboard
keybind = super+n=new_window
keybind = ctrl+shift+n=new_window
keybind = super+q=quit
keybind = super+t=new_tab
keybind = super+v=paste_from_clipboard
keybind = super+w=close_surface
keybind = copy=copy_to_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = paste=paste_from_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
#<}}}

